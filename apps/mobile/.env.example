# 실기기에서는 localhost 가 기기 자신을 가리킨다.
# 같은 와이파이의 개발 PC 주소를 넣어야 붙는다. 예) http://192.168.0.10:4000/api/v1
EXPO_PUBLIC_API_URL=http://localhost:4000/api/v1

# 카카오 — 개발자센터 > 앱 키 > **네이티브 앱 키** (REST API 키가 아니다)
EXPO_PUBLIC_KAKAO_NATIVE_APP_KEY=

# 구글 — 클라우드 콘솔에서 iOS / Android 클라이언트를 따로 만든다.
#   웹 클라이언트 ID:  ID 토큰의 aud 가 되는 값. 서버의 GOOGLE_CLIENT_ID 와 같다.
#   iOS URL 스킴:      iOS 클라이언트 ID 를 거꾸로 쓴 값 (com.googleusercontent.apps.xxx)
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_URL_SCHEME=
