DATABASE_URL="postgresql://mun@localhost:5432/nadaena?schema=public"
PORT=4000
NODE_ENV=development

# openssl rand -base64 48
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

# 소셜 로그인 콜백을 받는 곳 (웹)
OAUTH_REDIRECT_BASE=http://localhost:3000

# 웹 말고 허용할 콜백 주소. 쉼표로 구분한다.
# 앱은 네이티브 SDK 로 토큰을 받아 와서 콜백 주소가 없다 — 지금은 비워둔다.
OAUTH_ALLOWED_REDIRECT_URIS=

# https://developers.kakao.com — 앱 키 > REST API 키 / 보안 > Client Secret
KAKAO_REST_API_KEY=
KAKAO_CLIENT_SECRET=

# https://console.cloud.google.com — 사용자 인증 정보 > OAuth 클라이언트 ID
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# 앱이 보낸 ID 토큰의 aud 로 허용할 값 (쉼표 구분).
# GOOGLE_CLIENT_ID 는 항상 허용되므로 iOS 클라이언트 ID 만 넣으면 된다.
GOOGLE_ALLOWED_AUDIENCES=
